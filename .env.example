# Variables de Entorno - ELI Project
# Copia este archivo como .env y reemplaza los valores con los tuyos

# OpenAI API Key (para OCR con GPT-5-mini)
# Obtén tu API key en: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=tu-api-key-aqui

# Path to Poppler binaries (for PDF processing)
# Descarga Poppler desde: https://github.com/oschwartz1066/poppler-windows/releases/
POPPLER_PATH=C:\poppler\Library\bin

# Django Settings (opcional)
DEBUG=True
SECRET_KEY=tu-secret-key-aqui

# Base de Datos (opcional, si usas variables de entorno)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
